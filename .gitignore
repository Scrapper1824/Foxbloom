# Dependencies and build output (rebuilt by npm install / npm run build)
node_modules/
dist/
.update-backup/

# Everything Foxbloom stores at run time: the database (API keys, users), secret key, caches, logs.
# Never commit it.
data/
*.db
*.db-shm
*.db-wal
secret.key
setup-code.txt
.env
.env.*
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Written by the Windows installer next to Foxbloom (Settings → Apps uses it to uninstall).
/Uninstall Foxbloom.exe
/Uninstall Mediarr.exe
.superpowers/

# TV installer: sdb.exe and Samsung CA certificates are supplied by hand (see installer/tv/vendor/README.md)
installer/tv/vendor/*
!installer/tv/vendor/README.md

# Android app: Gradle output, the local SDK path, and the TV web app copied in at build time
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/web/
